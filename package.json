{
  "name": "merci-player",
  "version": "1.0.0",
  "private": true,
  "description": "A modern, minimal desktop media player for Windows.",
  "author": "Nzabana Merci",
  "main": "dist-electron/main.js",
  "scripts": {
    "dev": "concurrently -k \"vite --host 127.0.0.1\" \"wait-on http://127.0.0.1:5173 && electron .\"",
    "build": "tsc -b && vite build",
    "preview": "vite preview",
    "start": "electron .",
    "dist:win": "npm run build:icon && npm run build && electron-builder --win --publish never",
    "dist:dir": "npm run build:icon && npm run build && electron-builder --dir --publish never",
    "build:icon": "node scripts/create-icon.mjs"
  },
  "dependencies": {
    "lucide-react": "^0.468.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "music-metadata": "^10.9.1"
  },
  "devDependencies": {
    "@types/node": "^22.10.2",
    "@types/react": "^18.3.18",
    "@types/react-dom": "^18.3.5",
    "@vitejs/plugin-react": "^4.3.4",
    "concurrently": "^9.1.2",
    "electron": "^33.2.1",
    "electron-builder": "^25.1.8",
    "typescript": "~5.7.2",
    "vite": "^6.0.5",
    "wait-on": "^8.0.1",
    "sharp": "^0.33.5",
    "png-to-ico": "^2.1.8"
  },
  "build": {
    "appId": "com.merciplayer.desktop",
    "productName": "Merci Player",
    "directories": {
      "output": "release"
    },
    "files": [
      "dist/**/*",
      "dist-electron/**/*",
      "build/icon.ico",
      "package.json"
    ],
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        },
        {
          "target": "portable",
          "arch": [
            "x64"
          ]
        }
      ],
      "artifactName": "${productName}-${version}-${arch}.${ext}",
      "icon": "build/icon.ico"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "Merci Player",
      "artifactName": "${productName}-${version}-Setup-${arch}.${ext}"
    },
    "portable": {
      "artifactName": "${productName}-${version}-Portable-${arch}.${ext}"
    },
    "fileAssociations": [
      {
        "ext": [
          "mp4",
          "mkv",
          "avi",
          "mov",
          "webm",
          "m4v",
          "mpg",
          "mpeg",
          "wmv",
          "ts"
        ],
        "name": "Merci Player Video",
        "description": "Video files opened with Merci Player",
        "role": "Viewer",
        "icon": "build/icon.ico"
      },
      {
        "ext": [
          "mp3",
          "wav",
          "flac",
          "aac",
          "ogg",
          "m4a",
          "wma",
          "aiff",
          "opus"
        ],
        "name": "Merci Player Audio",
        "description": "Audio files opened with Merci Player",
        "role": "Viewer",
        "icon": "build/icon.ico"
      },
      {
        "ext": [
          "png",
          "jpg",
          "jpeg",
          "gif",
          "webp",
          "bmp",
          "avif",
          "svg"
        ],
        "name": "Merci Player Image",
        "description": "Image files opened with Merci Player",
        "role": "Viewer",
        "icon": "build/icon.ico"
      }
    ]
  }
}
